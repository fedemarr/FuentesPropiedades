# ============================================================================
# FUENTES PROPIEDADES — Variables de entorno
# Copiá este archivo a .env y completá los valores reales.
# ============================================================================

# --- Base de datos (PostgreSQL en Neon) -------------------------------------
# En Neon, DATABASE_URL es la conexión "pooled" (con -pooler en el host) y
# DIRECT_URL es la conexión directa sin pooler, necesaria para las
# migraciones. Copiá ambas desde el dashboard de Neon → Connection Details.
# Para desarrollo local sin Neon podés usar `npx prisma dev` (Postgres local
# de Prisma) y pegar acá la URL que te imprime ese comando en las dos
# variables.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- NextAuth v5 -------------------------------------------------------------
# Genera un secreto con: npx auth secret   (o `openssl rand -base64 32`)
AUTH_SECRET="{{PENDIENTE}}"
# URL pública del sitio en producción (sin barra final). En desarrollo se usa
# http://localhost:3000 automáticamente si se deja vacío.
NEXTAUTH_URL="http://localhost:3000"

# --- Cloudinary (subida de imágenes) ----------------------------------------
# Dashboard de Cloudinary → Settings → Access Keys.
# CLOUDINARY_API_SECRET nunca debe llegar al cliente: solo se usa en el
# servidor para firmar los uploads directos desde el navegador.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="{{PENDIENTE}}"
CLOUDINARY_API_KEY="{{PENDIENTE}}"
CLOUDINARY_API_SECRET="{{PENDIENTE}}"

# --- Sitio -------------------------------------------------------------------
# Usada en metadata, Open Graph, JSON-LD y el sitemap. Sin barra final.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
